<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Geopolitics.Core</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Geopolitics.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>
      Geopolitics kernel: polities, provinces, relations, treaties, wars, and the civic/fiscal
      stock-flow engine. No RNG, combat, trade, AI, or fiction seed data.
    </Description>
  </PropertyGroup>
</Project>

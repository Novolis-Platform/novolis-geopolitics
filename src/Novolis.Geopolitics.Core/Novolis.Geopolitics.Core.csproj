<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Geopolitics.Core</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Geopolitics.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>
      Geopolitics kernel: polities, provinces, relations, treaties, wars, and civic/fiscal
      stock-flow (delegates nation civic settlement to Novolis.Civics.Core).
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Novolis.Civics.Core" />
  </ItemGroup>
</Project>
